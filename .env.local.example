# =============================================================================
# AUTHENTICATION - WorkOS (Required by the full HackerAI app)
# =============================================================================
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_AUTH_DOMAIN=api.workos.com
WORKOS_COOKIE_PASSWORD=
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
ACCOUNT_IDENTITY_HMAC_SECRET=
WORKOS_WEBHOOK_SECRET=

# =============================================================================
# CONVEX DATABASE
# =============================================================================
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_SERVICE_ROLE_KEY=
CONVEX_USER_RESEARCH_SERVICE_KEY=

# =============================================================================
# AI PROVIDERS
# =============================================================================
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Local Ollama/OpenAI-compatible model
HACKERAI_LOCAL_MODEL=true
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=hacker-local

# =============================================================================
# Dr.Binary remote MCP
# =============================================================================
DRBINARY_MCP_ENABLED=true
DRBINARY_MCP_URL=https://mcp.drbinary.ai/mcp
DRBINARY_MCP_TIMEOUT_MS=600000
# Optional bearer token if your authenticated MCP session provides one.
# DRBINARY_MCP_AUTH_TOKEN=
# Optional JSON object of additional MCP headers.
# DRBINARY_MCP_HEADERS_JSON={}

# =============================================================================
# Sandbox / runtime dependencies used by the existing HackerAI Agent
# =============================================================================
E2B_API_KEY=
E2B_TEMPLATE=terminal-agent-sandbox
TRIGGER_PROJECT_ID=proj_
TRIGGER_SECRET_KEY=tr_dev_

# =============================================================================
# Optional services
# =============================================================================
PERPLEXITY_API_KEY=
JINA_API_KEY=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET_NAME=
NEXT_PUBLIC_BASE_URL=http://localhost:3000
CENTRIFUGO_TOKEN_SECRET=
CENTRIFUGO_WS_URL=ws://localhost:8000/connection/websocket
